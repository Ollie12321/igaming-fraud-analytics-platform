# AWS (hybrid deploy: only S3 / Kinesis / DynamoDB / Lambda are actually provisioned;
# see terraform/ and README.md for why Redshift/MWAA are intentionally NOT deployed)
AWS_REGION=eu-west-2
AWS_PROFILE=

S3_RAW_BUCKET=igaming-fraud-analytics-raw
S3_EVENTS_PREFIX=events
KINESIS_STREAM_NAME=igaming-player-events
DYNAMODB_FRAUD_STATE_TABLE=igaming-fraud-state
DYNAMODB_FRAUD_FLAGS_TABLE=igaming-fraud-flags

# Local warehouse (Postgres, stands in for Redshift)
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5433
WAREHOUSE_DB=igaming
WAREHOUSE_USER=igaming
WAREHOUSE_PASSWORD=igaming

# Data generation
NUM_PLAYERS=10000
SIMULATION_DAYS=150
RANDOM_SEED=42
FRAUD_INJECTION_RATE=0.015

# Governance (see docs/data_governance.md). Change this in any real deployment;
# it's used to pseudonymise direct identifiers on right-to-erasure requests.
GOVERNANCE_ERASURE_SALT=local-dev-salt-change-in-production

# Streamlit app: leave false for local runs against the live warehouse.
# Set to true only on the public Community Cloud deployment, which reads
# streamlit_app/snapshot_data/ instead (see README).
USE_SNAPSHOT_DATA=false
